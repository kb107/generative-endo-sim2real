# Copy to .env and replace the placeholders. .env is git-ignored; never commit it.
# Folder that holds SimCol3D/ and C3VDv2/ (read-only datasets).
export DATA_ROOT=/path/to/data
# Hugging Face cache for model weights; scripts/setup_da3.sh requires it (set it here or in the shell).
# export HF_HOME=/path/to/hf-cache
# Only for the closed-editor comparison (scripts/foundation_gemini.sh with EXECUTE=1). Leave empty otherwise.
export GEMINI_API_KEY=
# Existing shell cache/temp settings are inherited; do not redirect them here.
